# A host to run playbooks against: sshd, python, nothing else.
#
# Reached by key only. The previous version also set a root password and enabled
# password login, which made the test fixture the weakest thing in the
# repository; the generated key is enough.

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        openssh-server \
        python3 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/run/sshd /root/.ssh && chmod 700 /root/.ssh

# Generated by `make keygen`, never committed.
COPY keys/id_rsa.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys

# Key-only root login: prohibit-password is the default in bookworm, so this
# only makes the intent explicit and survives a base image changing its mind.
RUN sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config

# Ansible writes its temporary files here when it connects.
RUN mkdir -p /tmp/.ansible/tmp && chmod 1777 /tmp/.ansible

EXPOSE 22

CMD ["/usr/sbin/sshd", "-D", "-e"]
