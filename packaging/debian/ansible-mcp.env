# Configuration for ansible-mcp. Every setting is optional except the API key
# when the service listens beyond loopback.

# Where the database, playbooks, task artifacts and inventories live.
ANSIBLE_MCP_DATA_DIR=/var/lib/ansible-mcp

# stdio expects a client to launch the process; a service wants streamable-http.
ANSIBLE_MCP_TRANSPORT=streamable-http
ANSIBLE_MCP_HOST=127.0.0.1
ANSIBLE_MCP_PORT=8080

# Required to listen on anything but loopback. Every request is checked against
# it, so generate one and keep it out of version control:
#   openssl rand -hex 32
#ANSIBLE_MCP_API_KEY=

# How many playbooks may run at once, and how long one may take.
ANSIBLE_MCP_MAX_CONCURRENT_TASKS=4
#ANSIBLE_MCP_RUN_TIMEOUT_SECONDS=3600

ANSIBLE_MCP_LOG_LEVEL=INFO
